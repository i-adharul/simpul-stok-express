### Stock transfers (E5-04). Local server: cd server && npm run dev
# Needs the seed and all migrations: cd server && npx sequelize db:migrate && npx sequelize db:seed:all
# Log in first (http/auth.http); the token of the Owner goes into @token below.
@token = paste-the-token-here
@baseUrl = http://localhost:3000
# IDs from GET /api/warehouses and GET /api/products. The source needs stock (http/stock.http, receive).
@fromWarehouseId = paste-the-source-warehouse-id-here
@toWarehouseId = paste-the-destination-warehouse-id-here
@productId = paste-a-product-id-here
# A new UUID each time you want a NEW transfer. Sending the SAME one again is a replay.
@key = 5e2d9c41-8a3b-4f6e-9d17-0b4c7a1e2f33

### Transfer stock (Owner, or Warehouse Admin of an ASSIGNED source warehouse)
# The destination may be any active warehouse of the organization. One transaction for all items.
# Expect 201 { id, code ("MT-0001", sequential per organization), fromWarehouseId, toWarehouseId,
#   items: [{ productId, quantity }] (ordered by product ID), note, createdAt } (no balances).
# Send it again with the same Idempotency-Key: the same 201 body plus the header Idempotency-Replayed: true,
# and no second transfer.
# 400 VALIDATION_ERROR: no or malformed Idempotency-Key, source equal to destination, 0 or more than 50 items,
#   a product twice, quantity outside 1..1000000, note over 255 characters, unknown field.
# 403 FORBIDDEN (one body): a Viewer, or a source that is unassigned, archived, foreign or missing.
# 404 NOT_FOUND (one body): a destination or product that is foreign or missing.
# 409 CONFLICT: an archived destination or product, a destination total above 2147483647, or
#   "Terlalu banyak mutasi bersamaan, coba lagi." (code collision after 5 retries; send it again).
# 409 INSUFFICIENT_STOCK with details { productId }: the first item (by product ID) the source cannot cover;
#   nothing is written.
POST {{baseUrl}}/api/stock/transfers
Authorization: Bearer {{token}}
Idempotency-Key: {{key}}
Content-Type: application/json

{
  "fromWarehouseId": "{{fromWarehouseId}}",
  "toWarehouseId": "{{toWarehouseId}}",
  "items": [{ "productId": "{{productId}}", "quantity": 4 }],
  "note": "Kirim ke cabang"
}

### Several items in one transfer
# Every item must be covered, or none moves. Replace the second product ID.
POST {{baseUrl}}/api/stock/transfers
Authorization: Bearer {{token}}
Idempotency-Key: 9a8f1d2c-3b4e-4c5d-8e6f-7a0b1c2d3e44
Content-Type: application/json

{
  "fromWarehouseId": "{{fromWarehouseId}}",
  "toWarehouseId": "{{toWarehouseId}}",
  "items": [
    { "productId": "{{productId}}", "quantity": 1 },
    { "productId": "paste-another-product-id-here", "quantity": 2 }
  ]
}

### More than the source holds
# Expect 409 INSUFFICIENT_STOCK with details { "productId": "..." }; the source stock is unchanged.
POST {{baseUrl}}/api/stock/transfers
Authorization: Bearer {{token}}
Idempotency-Key: 1c2b3a49-5d6e-4f70-8a9b-0c1d2e3f4a55
Content-Type: application/json

{ "fromWarehouseId": "{{fromWarehouseId}}", "toWarehouseId": "{{toWarehouseId}}", "items": [{ "productId": "{{productId}}", "quantity": 1000000 }] }

### Source equal to destination
# Expect 400 VALIDATION_ERROR with details [{ "source": "body", "path": "toWarehouseId", "message": "Gudang tujuan harus berbeda dari gudang asal." }]
POST {{baseUrl}}/api/stock/transfers
Authorization: Bearer {{token}}
Idempotency-Key: 2d3c4b5a-6e7f-4081-9bac-1d2e3f4a5b66
Content-Type: application/json

{ "fromWarehouseId": "{{fromWarehouseId}}", "toWarehouseId": "{{fromWarehouseId}}", "items": [{ "productId": "{{productId}}", "quantity": 1 }] }

### Missing Idempotency-Key
# Expect 400 VALIDATION_ERROR with details [{ "source": "header", "path": "Idempotency-Key", "message": "Wajib diisi." }]
POST {{baseUrl}}/api/stock/transfers
Authorization: Bearer {{token}}
Content-Type: application/json

{ "fromWarehouseId": "{{fromWarehouseId}}", "toWarehouseId": "{{toWarehouseId}}", "items": [{ "productId": "{{productId}}", "quantity": 1 }] }

### Destination that does not exist (or belongs to another organization)
# Expect 404 NOT_FOUND, the same body for both.
POST {{baseUrl}}/api/stock/transfers
Authorization: Bearer {{token}}
Idempotency-Key: 3e4d5c6b-7f80-4192-8cbd-2e3f4a5b6c77
Content-Type: application/json

{ "fromWarehouseId": "{{fromWarehouseId}}", "toWarehouseId": "33333333-3333-4333-8333-333333333333", "items": [{ "productId": "{{productId}}", "quantity": 1 }] }

### One transfer (every tenant role; S12)
# Visible when the caller reaches the source OR the destination warehouse (an Owner reaches every active one).
# Expect 200 { id, code, note, createdAt, createdBy { id, name, role } | null, fromWarehouse { id, code, name, address },
#   toWarehouse { ... }, items: [{ productId, sku, name, unit, quantity, outMovementId, inMovementId }] } ordered by product ID.
# A movement ID is null when its warehouse is not one the caller reaches. No balances, no email.
# 404 NOT_FOUND (one body): a malformed id, a missing one, another organization's, or one outside the caller's warehouses.
@transferId = paste-the-id-of-a-transfer-here
GET {{baseUrl}}/api/stock/transfers/{{transferId}}
Authorization: Bearer {{token}}

### Transfer destinations (Owner or Warehouse Admin; a Viewer gets 403)
# Every ACTIVE warehouse of the organization, ordered by code: { items: [{ id, code, name }] }.
# A Warehouse Admin sees all of them here, not only the assigned ones (the destination may be any).
# No query parameters: any parameter is a 400 VALIDATION_ERROR.
GET {{baseUrl}}/api/stock/transfers/destinations
Authorization: Bearer {{token}}
