### Invite a member (Owner only). First log in with http/auth.http and paste the token.
# Expect 201 {"invitation":{"id","email","role","warehouseIds","expiresAt","status":"PENDING"},"token"} and Cache-Control: no-store.
# This is the only response that holds the raw token. Link to give: <client>/invite/<token>.
POST http://localhost:3000/api/invitations
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": "sari@example.com", "role": "VIEWER", "warehouseIds": [] }

### Role OWNER is refused
# Expect 400 VALIDATION_ERROR with details [{ "source": "body", "path": "role", ... }]
POST http://localhost:3000/api/invitations
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": "sari@example.com", "role": "OWNER" }

### Same email again while the first invitation is pending
# Expect 409 CONFLICT with details [{ "source": "body", "path": "email", ... }]
POST http://localhost:3000/api/invitations
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": "sari@example.com", "role": "VIEWER" }

### List pending and expired invitations (Owner only)
# Expect 200 {"items":[...],"total","page","pageSize"}; items never hold a token or tokenHash.
GET http://localhost:3000/api/invitations?page=1&pageSize=20
Authorization: Bearer {{token}}

### Cancel an invitation (use an "id" from the list)
# Expect 204. An accepted, foreign, unknown or malformed ID gives an identical 404.
DELETE http://localhost:3000/api/invitations/00000000-0000-4000-8000-000000000000
Authorization: Bearer {{token}}

### Open an invitation link (public, no token header). Use the "token" from the POST /api/invitations response.
# Expect 200 {"email","role","organizationName","expiresAt"}. A malformed, unknown, expired or used token gives one identical 404.
GET http://localhost:3000/api/invitations/PASTE_THE_RAW_TOKEN_HERE

### Accept the invitation (public). The new member gets a token and lands on /dashboard.
# Expect 200 {"token","user":{"id","name","email","role"},"redirectTo":"/dashboard"} and Cache-Control: no-store.
# A second call with the same token gives 404; a password equal to the invited email gives 400; an email that now belongs to another user gives 409.
POST http://localhost:3000/api/auth/accept-invite
Content-Type: application/json

{ "token": "PASTE_THE_RAW_TOKEN_HERE", "name": "Sari Gudang", "password": "Gula-Kopi-2026" }
