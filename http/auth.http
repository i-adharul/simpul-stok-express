### Login (public, no token). Local server: cd server && npm run dev
# @name login
# Needs the seed: cd server && npx sequelize db:seed:all
# Expect 200 {"token","user":{"id","name","email","role"},"redirectTo":"/dashboard"} and Cache-Control: no-store.
# The email is trimmed and matched in lowercase. The token holds only sub, iat and exp (8 hours).
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "owner@example.com", "password": "Simpul-Demo-2026" }

### Platform admin: same call, redirectTo is "/platform"
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "platform@example.com", "password": "Simpul-Demo-2026" }

### Owner of the second demo organization (Kopi Senja): same call, other data
# Needs the demo reset: cd server && npm run demo:reset. Expect 200 and a user with the role OWNER.
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "owner@kopisenja.example.com", "password": "Simpul-Demo-2026" }

### Wrong password, unknown email, inactive user, password over 72 bytes: one identical answer
# Expect 401 {"code":"INVALID_CREDENTIALS","message":"Email atau password salah.","details":null}
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "owner@example.com", "password": "wrong-password-1" }

### Missing field or unknown field
# Expect 400 VALIDATION_ERROR with details [{ "source": "body", "path": "password", "message": "Wajib diisi." }]
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{ "email": "owner@example.com" }

### Current user. Run the first request ("login") before this one, then paste its token.
# Expect 200 {"user":{"id","name","email","role"},"organization":{"id","name","slug","status"} | null}
GET http://localhost:3000/api/me
Authorization: Bearer {{login.response.body.token}}

### No token, a broken token, an expired token, an inactive user: one identical answer
# Expect 401 {"code":"UNAUTHENTICATED","message":"Sesi tidak valid. Silakan masuk lagi.","details":null}
GET http://localhost:3000/api/me

### Logout: always 204, with or without a token. The server keeps no session; the client deletes its token.
POST http://localhost:3000/api/auth/logout

### Change password. Run "login" first. Success returns a NEW token; every older token (also on other devices) gets 401.
# Expect 200 {"token"}. A wrong current password gives 400 INVALID_CURRENT_PASSWORD.
# A refused new password gives 400 VALIDATION_ERROR with the reason in message and in details[0].
# Note: this changes the seeded password. Undo it with a second call that puts the demo password back.
PATCH http://localhost:3000/api/me/password
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "currentPassword": "Simpul-Demo-2026", "newPassword": "Kopi-Susu-2027" }

### Sign up a new organization (public, BL04)
# Expect 201 {"token","user":{...,"role":"OWNER"},"organization":{...,"status":"TRIAL"},"redirectTo":"/dashboard"} and Cache-Control: no-store.
# Needs the plans seed (Starter). Use the token on GET /api/me. A second call with the same email or slug gives 409 CONFLICT.
POST http://localhost:3000/api/auth/register-organization
Content-Type: application/json

{
  "organizationName": "Toko Maju",
  "slug": "tokomaju",
  "name": "Budi Santoso",
  "email": "budi@tokomaju.example",
  "password": "Gula-Kopi-2026"
}

### Invalid slug and weak password
# Expect 400 VALIDATION_ERROR with details for "slug" and "password".
POST http://localhost:3000/api/auth/register-organization
Content-Type: application/json

{
  "organizationName": "Toko Maju",
  "slug": "Toko-Maju",
  "name": "Budi Santoso",
  "email": "budi@tokomaju.example",
  "password": "short"
}

### Open a reset link (public, no token header). Use the "token" from POST /api/members/:id/reset-link.
# Expect 200 {"email"}. A malformed, unknown, replaced, used or expired token, or an inactive member, gives one identical 404.
GET http://localhost:3000/api/auth/reset-password/PASTE_THE_RAW_TOKEN_HERE

### Set a new password with the reset link (public). Single-use; every older token of the member gets 401.
# Expect 204 with no body. Then sign in with the new password through POST /api/auth/login.
# A second call with the same token gives 404 (checked before the password); a refused password gives 400 VALIDATION_ERROR.
POST http://localhost:3000/api/auth/reset-password
Content-Type: application/json

{ "token": "PASTE_THE_RAW_TOKEN_HERE", "password": "Kopi-Susu-2027" }
